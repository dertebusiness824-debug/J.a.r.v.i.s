# --- LLM ---
# Groq es el proveedor por defecto: es el más rápido y la voz necesita baja latencia.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# groq | openai | anthropic. Si el elegido no tiene clave, se usa el primero que la tenga.
PLANNER_PROVIDER=groq
# Modelos de Groq. Los Llama (llama-3.1-8b-instant, llama3-70b-8192) están retirados
# para cuentas free/developer; comprueba los activos en /openai/v1/models.
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_EXECUTOR_MODEL=openai/gpt-oss-20b
# Modelos de OpenAI/Anthropic si usas esos proveedores.
PLANNER_MODEL=gpt-4o
EXECUTOR_MODEL=gpt-4o

# true = sin llamadas a LLM (router heurístico + herramientas reales)
JARVIS_OFFLINE=false

# --- Memoria ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=jarvis_memory

# --- Code Agent sandbox ---
WORKSPACE_ROOT=./sandbox
TERMINAL_TIMEOUT_SECONDS=30

# --- Shopify (Shop Agent) ---
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Zadarma PBX ---
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_PBX_ID=

# --- WhatsApp Web (puente local whatsapp-web.js) ---
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_ALLOWED_NUMBER=34605686509
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# URL pública (Vapi custom-llm / server events)
JARVIS_PUBLIC_URL=https://j-a-r-v-i-s-yghr.onrender.com

# --- Correo IMAP ---
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=993
EMAIL_FOLDER=INBOX
EMAIL_USE_SSL=true

# --- API ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_MAX_ITERATIONS=8
JARVIS_RECURSION_LIMIT=25

# --- Vapi (Custom LLM + WebRTC) ---
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
# Tope de espera del Supervisor antes de contestar algo hablable (Vapi corta la llamada si no recibe nada).
VAPI_RESPONSE_TIMEOUT_SECONDS=30
# Cada cuántos segundos se manda un comentario SSE de keep-alive mientras LangGraph piensa.
VAPI_KEEPALIVE_SECONDS=5

# --- Cartesia TTS ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6

# --- Research Agent (OSINT) ---
TAVILY_API_KEY=
# Hunter.io Domain Search (find_public_emails). HUNTER_API_KEY sigue valiendo como alias.
HUNTERIO_API_KEY=
HUNTER_API_KEY=
