# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic
PLANNER_PROVIDER=openai
# o1 / o1-preview / claude-3-5-sonnet-latest
PLANNER_MODEL=gpt-4o
EXECUTOR_MODEL=gpt-4o

# true = sin llamadas a LLM (router heurístico + herramientas reales)
JARVIS_OFFLINE=false

# --- Memoria ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=jarvis_memory

# --- Code Agent sandbox ---
WORKSPACE_ROOT=./sandbox
TERMINAL_TIMEOUT_SECONDS=30

# --- Command Emission (local_node.py) ---
# Secreto compartido entre el backend y el nodo local que crea proyectos en tu PC.
# Sin él, /api/commands queda abierto. Usa el mismo valor en tu ordenador:
#   JARVIS_NODE_TOKEN=... python local_node.py --url https://<host>
# El mismo token autentica el WebSocket /ws/device-control:
#   JARVIS_NODE_TOKEN=... python local_client.py
# JARVIS_WS_URL=wss://j-a-r-v-i-s-yghr.onrender.com/ws/device-control
JARVIS_NODE_TOKEN=

# --- Shopify (Shop Agent) ---
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Zadarma PBX ---
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_PBX_ID=

# --- WhatsApp Web (puente local whatsapp-web.js) ---
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_ALLOWED_NUMBER=34605686509
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# URL pública (Vapi custom-llm / server events)
JARVIS_PUBLIC_URL=https://j-a-r-v-i-s-yghr.onrender.com

# --- Correo IMAP ---
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=993
EMAIL_FOLDER=INBOX
EMAIL_USE_SSL=true

# --- API ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_MAX_ITERATIONS=8
JARVIS_RECURSION_LIMIT=25

# --- Vapi (Custom LLM + WebRTC) ---
VAPI_PUBLIC_KEY=
# Asistente guardado en el panel de Vapi (modelo, voz Onyx y prompt viven allí).
# Con este valor el botón HABLAR arranca ese asistente; vacío, el HUD monta uno efímero.
VAPI_ASSISTANT_ID=7f5e8df0-c8b6-4fb1-97f7-8a3c24364b1b
# Secreto del Server URL de Vapi. Un valor plano exige Authorization: Bearer
# (o X-Vapi-Secret) en Custom LLM y en /api/jarvis/vapi-events. Un whsec_… es
# firma HMAC (Standard Webhooks): protege los eventos de servidor y no corta
# la voz — Vapi no firma el Custom LLM con esa clave.
VAPI_WEBHOOK_SECRET=
# Tope de espera del Supervisor antes de contestar algo hablable. Debe quedar por
# debajo del timeoutSeconds (90) que Vapi aplica al Custom LLM.
VAPI_RESPONSE_TIMEOUT_SECONDS=75
# Cada cuántos segundos se manda un comentario SSE de keep-alive mientras LangGraph piensa.
VAPI_KEEPALIVE_SECONDS=5
# Margen antes de decir una frase puente ("Analizando la directiva…"). Si el grafo
# contesta antes, no se dice nada; 0 la suelta siempre en el primer chunk.
VAPI_FILLER_DELAY_SECONDS=0.15
# Silencio máximo en llamada: pasado este tiempo sin novedades del grafo se dice
# una frase de espera ("Sigo en ello, maestro…"). Un keep-alive no cuenta como voz.
VAPI_IDLE_SPEECH_SECONDS=9

# --- Cartesia TTS ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6

# --- Research Agent (OSINT) ---
# Búsqueda web vía SDK oficial de Tavily. Sin clave, web_search cae en DuckDuckGo.
TAVILY_API_KEY=
# Hunter.io Domain Search (find_public_emails). HUNTER_API_KEY sigue valiendo como alias.
HUNTERIO_API_KEY=
HUNTER_API_KEY=
