# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic
PLANNER_PROVIDER=openai
# o1 / o1-preview / claude-3-5-sonnet-latest
PLANNER_MODEL=gpt-4o
EXECUTOR_MODEL=gpt-4o

# true = sin llamadas a LLM (router heurístico + herramientas reales)
JARVIS_OFFLINE=false

# --- Memoria ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=jarvis_memory

# --- Code Agent sandbox ---
WORKSPACE_ROOT=./sandbox
TERMINAL_TIMEOUT_SECONDS=30

# --- Shopify (Shop Agent) ---
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Zadarma PBX ---
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_PBX_ID=

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- API ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_MAX_ITERATIONS=8
JARVIS_RECURSION_LIMIT=25

# --- Vapi (Custom LLM + WebRTC) ---
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# --- Cartesia TTS ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
